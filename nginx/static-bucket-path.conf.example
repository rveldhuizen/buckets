# Alternative: expose a bucket at https://example.com/demo/.
# The trailing slash after proxy_pass intentionally removes /demo/ before proxying.

location /demo/ {
    proxy_pass http://static-buckets:8080/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Static-Bucket demo;
}
